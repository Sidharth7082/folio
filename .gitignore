# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Packaged builds from scripts/package.mjs. Reproducible, and large enough once
# a catalogue is bundled that committing it would be hostile.
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# imported catalogue database (derived — rebuild with: npm run catalogue:import -- <dump.gz>)
/data/*.db
# cached RanobeDB cover images (derived — safe to delete)
/data/covers/
next-env.d.ts

# Personal library. Books you import are usually not yours to redistribute, and
# this repository is public — so only the two demo novels that ship with the
# project are tracked. If your own repository is private and you want your
# library in it, delete the two /content/* rules below.
/content/*
!/content/signal-drift/
!/content/the-lantern-between-stars/

# Covers for imported books are the publishers' and artists' artwork, not
# something this project can redistribute.
/public/covers/*
!/public/covers/signal-drift.svg
!/public/covers/the-lantern-between-stars.svg
